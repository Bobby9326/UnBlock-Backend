# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (Supabase Postgres) ─────────────────────────
# From Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL = the POOLED connection (Transaction pooler, port 6543) used by
#   the running app. Append pgbouncer flags so Prisma plays nicely with it.
# DIRECT_URL   = the DIRECT connection (Session, port 5432) used ONLY by
#   `prisma migrate` / `prisma db push`.
#
# Replace [PROJECT-REF], [PASSWORD] and the region host with your own values.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── Auth cookie (httpOnly) ───────────────────────────────
AUTH_COOKIE_NAME="unblock_token"
# Cookie lifetime in ms — keep in sync with JWT_EXPIRES_IN (default 7 days).
TOKEN_MAX_AGE_MS=604800000
# Browser origins allowed to send the cookie (comma-separated, no trailing slash).
# Supports single-label wildcards, e.g. https://*.vercel.app for preview deploys.
# Prod example: "https://unblock.vercel.app,https://*.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── File Upload (Supabase Storage) ───────────────────────
# From Supabase dashboard → Project Settings → API.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Use the SERVICE ROLE key on the backend (bypasses RLS; keep it secret,
# never expose it to the frontend).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Storage bucket name (create it in Storage; set it Public for readable URLs).
SUPABASE_BUCKET="uploads"
# Max upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# ─── Orphan-file cleanup job ──────────────────────────────
# Cron expression for the cleanup job (default: every hour).
CLEANUP_CRON="0 * * * *"
# Delete unreferenced uploads older than this many hours.
ORPHAN_MAX_AGE_HOURS=24

# ─── Seed: initial Super Admin ────────────────────────────
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="admin@unblock.local"
SEED_ADMIN_PASSWORD="Admin@12345"
